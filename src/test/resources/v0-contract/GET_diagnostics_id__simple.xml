<?xml version="1.0"?>
<SimpleDiagnostic type="SimpleDiagnostic">
  <cliMode>enable</cliMode>
  <command>show version | include reason</command>
  <deviceDriver>CiscoIOS12</deviceDriver>
  <deviceDriverDescription>Cisco IOS and IOS-XE</deviceDriverDescription>
  <enabled>true</enabled>
  <id>1</id>
  <modifierPattern>(?s).*reason: (.+?)\n.*</modifierPattern>
  <modifierReplacement>$1</modifierReplacement>
  <name>Reload reason</name>
  <resultType>TEXT</resultType>
  <targetGroup type="DynamicDeviceGroup">
    <changeDate>&lt;now&gt;</changeDate>
    <folder>Production</folder>
    <hiddenFromReports>false</hiddenFromReports>
    <id>2</id>
    <name>All Cisco devices</name>
    <query>[Family] contains &quot;Cisco&quot;</query>
  </targetGroup>
</SimpleDiagnostic>
