<?xml version="1.0" encoding="UTF-8"?>
<configuration>

	<appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
		<encoder>
			<pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
		</encoder>
	</appender>

	<!-- Keep Netshot's own logs visible while running tests. -->
	<logger name="net.netshot" level="INFO" />

	<!-- Connection pooling, schema migration and container startup are
	     equally noisy at DEBUG and rarely useful in test output. -->
	<logger name="com.mchange" level="WARN" />
	<logger name="liquibase" level="WARN" />
	<logger name="org.testcontainers" level="WARN" />
	<logger name="com.github.dockerjava" level="WARN" />

	<root level="WARN">
		<appender-ref ref="STDOUT" />
	</root>

</configuration>
